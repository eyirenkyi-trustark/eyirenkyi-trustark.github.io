---
import { nav, site } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__name" href="/">{site.shortTitle}</a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Switch colour theme"
      aria-pressed="false"
    >
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path
          d="M12 2.5v2.2M12 19.3v2.2M4.22 4.22l1.56 1.56M18.22 18.22l1.56 1.56M2.5 12h2.2M19.3 12h2.2M4.22 19.78l1.56-1.56M18.22 5.78l1.56-1.56"
        ></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule-weight) solid var(--rule);
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4.25rem;
    flex-wrap: wrap;
  }

  .site-header__name {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-title);
    font-size: var(--step-body);
    margin-right: auto;
  }

  .site-header__name:hover {
    text-decoration: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav__link {
    font-size: var(--step-caption);
    color: var(--ink-muted);
    padding-block: var(--space-3xs);
    transition: color var(--duration-fast) var(--ease);
  }

  .site-nav__link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .site-nav__link.is-current {
    color: var(--ink);
    box-shadow: inset 0 -1px 0 0 var(--ink);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: var(--rule-weight) solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    color: var(--ink-muted);
    transition:
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .theme-toggle__icon--moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    display: block;
  }

  @media (max-width: 40rem) {
    .site-header {
      position: static;
    }

    .site-header__inner {
      padding-block: var(--space-s);
    }

    .site-nav {
      order: 3;
      width: 100%;
    }

    .site-nav__list {
      gap: var(--space-s);
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function sync() {
    const isDark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(isDark));
  }

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Storage can be unavailable in private modes. Theme still applies. */
    }
    sync();
  });

  sync();
</script>
