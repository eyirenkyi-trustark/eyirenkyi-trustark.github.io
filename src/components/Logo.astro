---
/**
 * Monochrome wordmark.
 *
 * These are typographic wordmarks set in the site's own typeface and
 * filled with currentColor, not copies of each company's trademarked
 * artwork. That keeps the logo strip visually consistent with the
 * black-on-off-white theme, inverts correctly in dark mode, and avoids
 * redistributing brand assets.
 */
interface Props {
  name: string;
  size?: 'sm' | 'md';
  class?: string;
}

const WORDMARKS: Record<string, { label: string; href?: string }> = {
  microsoft: { label: 'Microsoft', href: 'https://www.microsoft.com' },
  wise: { label: 'Wise', href: 'https://wise.com' },
  mpharma: { label: 'mPharma', href: 'https://mpharma.com' },
  genkey: { label: 'GenKey', href: 'https://www.genkey.com' },
  claimsync: { label: 'ClaimSync' },
};

const { name, size = 'md', class: className } = Astro.props;

const key = name.toLowerCase().replace(/[^a-z]/g, '');
const mark = WORDMARKS[key] ?? { label: name };
---

<span class:list={['logo', `logo--${size}`, className]} aria-label={mark.label}>
  <span class="logo__mark" aria-hidden="true"></span>
  <span class="logo__text">{mark.label}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  /* A small solid square reads as a mark without imitating any brand. */
  .logo__mark {
    width: 0.55em;
    height: 0.55em;
    background: currentColor;
    flex: none;
  }

  .logo--md {
    font-size: var(--step-subtitle);
  }

  .logo--sm {
    font-size: var(--step-caption);
    letter-spacing: 0;
  }
</style>
