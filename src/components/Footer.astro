---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__line">
      <span>Emmanuel Addo-Yirenkyi</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>{site.location}</span>
    </p>

    <ul class="site-footer__links">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/cv">CV</a></li>
    </ul>

    <p class="site-footer__meta">
      Views here are my own and do not represent my employer. Nothing on this site
      describes confidential systems, data or implementation detail.
    </p>

    <p class="site-footer__meta">
      &copy; {year}. Built with Astro. Hosted on GitHub Pages.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-weight) solid var(--rule);
    padding-block: var(--space-xl);
    margin-top: var(--space-3xl);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .site-footer__line {
    font-family: var(--font-sans);
    font-size: var(--step-caption);
    color: var(--ink);
  }

  .site-footer__sep {
    color: var(--ink-faint);
    margin-inline: var(--space-3xs);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step-caption);
  }

  .site-footer__links a {
    color: var(--ink-muted);
  }

  .site-footer__links a:hover {
    color: var(--ink);
  }

  .site-footer__meta {
    font-size: var(--step-micro);
    color: var(--ink-faint);
  }
</style>
